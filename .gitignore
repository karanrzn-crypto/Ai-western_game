# ============================================================
# .gitignore — Ai-western_game
# Stack: TypeScript + Vite + Three.js + esbuild → Vercel
# ============================================================

# -------------------- Dependencies --------------------
node_modules/
.npm
.pnpm-store/
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# -------------------- Build Outputs --------------------
# "site/" is the generated Vercel output (scripts/build.mjs)
site/
# "dist/" is the library build output (tsc)
dist/
build/
*.tsbuildinfo

# -------------------- Environment & Secrets --------------------
# NEVER commit secrets, API keys, or tokens
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx
*.key
credentials.json
secrets.json
secrets.yaml
secrets.yml
token.txt
tokens.json
oauth_tokens.json
service-account*.json

# -------------------- Logs & Temp --------------------
*.log
logs/
log/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.pid
*.pid.lock
tmp/
temp/
*.tmp

# -------------------- Test & Coverage --------------------
coverage/
.nyc_output/
*.lcov
.pytest_cache/

# -------------------- Caches --------------------
.cache/
.eslintcache
.stylelintcache
.parcel-cache

# -------------------- Editors & IDEs --------------------
# NOTE: must ignore directory CONTENTS (not the dir itself)
# so the negated files below actually work
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project
.history/

# -------------------- AI Coding Tools --------------------
# generated by AI assistants / coding agents — never commit
.claude/
.claude.json
.cursor/
.windsurf/
.serena/
.aider*
.z-ai-config
.zscripts/
.agentctx/
agent-ctx/
worklog.md

# -------------------- Operating System --------------------
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
# macOS
.DS_Store
.AppleDouble
._*
.Spotlight-V100
.Trashes
# Linux
.directory
.Trash-*
.fuse_hidden*
.nfs*

# -------------------- Vercel --------------------
.vercel

# -------------------- Databases --------------------
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal

# -------------------- Archives --------------------
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# ============================================================
# IMPORTANT — do NOT add these rules for this project:
#   *.bin   → breaks GLTF geometry buffer files (3D assets)
#   models/ → would silently ignore future 3D model folders
#   *.glb / *.gltf / *.fbx → these are legitimate game assets
# ============================================================

# Browser-verification screenshot artifacts (agent sessions)
shots-*/
